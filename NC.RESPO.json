    "matrix": [
        ["mana", "aura", "kraft", "licht", "fokus", "fluss", "vital", "balance", "drift"],
        ["aura", "kraft", "licht", "fokus", "fluss", "vital", "balance", "drift", "mana"],
        ["kraft", "licht", "fokus", "fluss", "vital", "balance", "drift", "mana", "aura"],
        ["licht", "fokus", "fluss", "vital", "balance", "drift", "mana", "aura", "kraft"],
        ["fokus", "fluss", "vital", "balance", "drift", "mana", "aura", "kraft", "licht"],
        ["fluss", "vital", "balance", "drift", "mana", "aura", "kraft", "licht", "fokus"],
        ["vital", "balance", "drift", "mana", "aura", "kraft", "licht", "fokus", "fluss"],
        ["balance", "drift", "mana", "aura", "kraft", "licht", "fokus", "fluss", "vital"],
        ["drift", "mana", "aura", "kraft", "licht", "fokus", "fluss", "vital", "balance"]
